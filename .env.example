# =============================================================================
# Zorar Code Backend - Supabase Environment Configuration
# =============================================================================

# منفذ تشغيل خادم NestJS
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. إعدادات قاعدة بيانات Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# رابط الاتصال المجمع عبر Supavisor / PgBouncer (للاستعلامات العادية داخل التطبيق - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# رابط الاتصال المباشر Direct Session (لعمل الـ Migrations وعمليات Prisma CLI - Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-SUPABASE-PROJECT]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# مفاتيح Supabase API (للتخزين السحابي Storage والـ Realtime إن استلزم الأمر)
SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# -----------------------------------------------------------------------------
# 2. إعدادات الكاش وطوابير الواتساب (Redis & BullMQ)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# -----------------------------------------------------------------------------
# 3. الأمان وحماية الفيديوهات (Security & Encryption Keys)
# -----------------------------------------------------------------------------
# مفتاح توقيع توكنات الجلسات (JWT)
JWT_SECRET="zorar-super-secure-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# مفتاح تشفير وفك تشفير معرفات يوتيوب AES-256 (32 حرف / 256-bit)
YOUTUBE_AES_SECRET_KEY="zorar-secure-aes-video-key-32ch"

# نطاق المنصة الأساسي (Default Root Domain)
PLATFORM_BASE_DOMAIN="eduzorar.com"
